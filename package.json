{
  "name": "profit-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "Production foundation for Profit Pilot affiliate operations.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "verify:staging:grounded-content": "pnpm --filter @profit-pilot/api evaluate:grounded-content",
    "verify:staging:awin": "pnpm --filter @profit-pilot/api verify:staging:awin-contract && pnpm --filter @profit-pilot/db verify:staging:awin"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prettier": "3.9.5",
    "turbo": "2.10.5",
    "typescript": "5.9.3"
  }
}
