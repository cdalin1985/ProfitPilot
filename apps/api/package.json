{
  "name": "@profit-pilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "evaluate:grounded-content": "tsx scripts/evaluate-grounded-content.ts",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "start": "node dist/main.js",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "verify:staging:awin-contract": "tsx scripts/verify-awin-contract.ts"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1097.0",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/sensible": "6.0.4",
    "@profit-pilot/authz": "workspace:*",
    "@profit-pilot/clicks": "workspace:*",
    "@profit-pilot/contracts": "workspace:*",
    "@profit-pilot/db": "workspace:*",
    "@profit-pilot/fixtures": "workspace:*",
    "@workos-inc/node": "10.8.0",
    "escape-html": "1.0.3",
    "fastify": "5.10.0",
    "jose": "6.1.2",
    "openai": "7.1.0",
    "pino": "10.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
